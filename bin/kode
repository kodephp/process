#!/usr/bin/env php
<?php

declare(strict_types=1);

require dirname(__DIR__) . '/vendor/autoload.php';

use Kode\Process\Kode;
use Kode\Process\Runtime;
use Kode\Process\Signal;

if (!defined('KODE_PID_FILE')) {
    define('KODE_PID_FILE', sys_get_temp_dir() . '/kode-process.pid');
}
if (!defined('KODE_CMD_FILE')) {
    define('KODE_CMD_FILE', sys_get_temp_dir() . '/kode-process.cmd');
}

$command = $argv[1] ?? 'help';

if (php_sapi_name() !== 'cli') {
    echo "Error: This script must be run from the command line.\n";
    exit(1);
}

switch ($command) {
    case 'start':
        $file = $argv[2] ?? 'server.php';

        if (!file_exists($file)) {
            echo "Error: File '{$file}' not found.\n";
            echo "Usage: kode start <file>\n";
            exit(1);
        }

        // PID 文件改由 master 进程在真正启动后写入（见 NativeRuntime::writePidFile），
        // 以兼容 daemonize 两次 fork 后 master PID 与 bin/kode 进程 PID 不同的情形；
        // 通过环境变量把标准 PID 路径透传给 master。仅记录启动命令供 restart 沿用。
        putenv('KODE_PID_FILE=' . KODE_PID_FILE);
        file_put_contents(KODE_CMD_FILE, $file);

        echo "Starting server from {$file}...\n";
        $code = include $file;
        break;

    case 'stop':
        $pidFile = KODE_PID_FILE;

        if (!file_exists($pidFile)) {
            echo "No PID file found. Is the server running?\n";
            exit(1);
        }

        $pid = (int) file_get_contents($pidFile);

        if (!isKodeMaster($pid)) {
            echo "Stale PID file (process not a running kode master). Cleaning up.\n";
            unlink($pidFile);
            @unlink(KODE_CMD_FILE);
            exit(1);
        }

        posix_kill($pid, Signal::TERM);
        // 等待优雅退出（最多约 5 秒）
        for ($i = 0; $i < 50; $i++) {
            if (!@posix_kill($pid, 0)) {
                break;
            }
            usleep(100_000);
        }
        // 超时仍未退出则强杀，避免残留孤儿
        if (@posix_kill($pid, 0)) {
            @posix_kill($pid, SIGKILL);
        }
        unlink($pidFile);
        @unlink(KODE_CMD_FILE);
        echo "Server stopped (PID: {$pid})\n";
        break;

    case 'restart':
        $file = $argv[2] ?? null;
        restartServer($file);
        break;

    case 'reload':
        $pidFile = KODE_PID_FILE;

        if (!file_exists($pidFile)) {
            echo "No PID file found. Is the server running?\n";
            exit(1);
        }

        $pid = (int) file_get_contents($pidFile);

        if (!isKodeMaster($pid)) {
            echo "Stale PID file (process not a running kode master). Cleaning up.\n";
            unlink($pidFile);
            @unlink(KODE_CMD_FILE);
            exit(1);
        }

        if (posix_kill($pid, Signal::HUP)) {
            echo "Server reloaded (PID: {$pid})\n";
        } else {
            echo "Failed to reload server.\n";
            exit(1);
        }
        break;

    case 'status':
        $pidFile = KODE_PID_FILE;

        if (!file_exists($pidFile)) {
            echo "Server is not running.\n";
            exit(0);
        }

        $pid = (int) file_get_contents($pidFile);

        if (isKodeMaster($pid)) {
            echo "Server is running (PID: {$pid})\n";
        } else {
            echo "Server is not running (stale PID file).\n";
            unlink($pidFile);
            @unlink(KODE_CMD_FILE);
            exit(1);
        }
        break;

    case 'process':
        runProcessCommand($argv);
        break;

    case 'check':
        printRequirements();
        break;

    case 'info':
        echo "Kode Process " . Kode::version() . "\n";
        echo "PHP Version: " . PHP_VERSION . "\n";
        echo "SAPI: " . php_sapi_name() . "\n";
        echo "Platform: " . PHP_OS . "\n";
        break;

    case 'help':
    default:
        echo <<<HELP
Kode Process - 高性能 PHP 进程管理器

用法:
    kode <command> [options]

命令:
    start <file>    启动服务 (默认 server.php)
    stop            停止服务
    restart <file>  平滑重启（停止旧进程并以新进程 detached 启动；不传 file 时沿用上次启动文件）
    reload          平滑重载
    status          查看状态
    process         常驻进程运行器（start/stop/restart/status，见 `kode process help`）
    check           运行时依赖自检（各运行时所需扩展 / 缺失提示）
    info            版本信息
    help            显示帮助

示例:
    kode start              # 启动 server.php
    kode start app.php     # 启动 app.php
    kode stop              # 停止服务
    kode restart           # 用上次启动的文件重启
    kode restart app.php   # 用指定文件重启
    kode reload            # 平滑重载
    kode status            # 查看状态
    kode check             # 检查 swoole/workerman/pcntl/posix 等扩展是否就绪

信号控制:
    kill -TERM \$PID       # 停止服务
    kill -HUP \$PID       # 平滑重载
    kill -USR2 \$PID       # 查看状态

HELP;
        break;
}

/**
 * 常驻进程运行器命令：start / stop / restart / status。
 *
 * <file> 必须 `return` 一个 Kode\Process\Daemon\Daemon 实例（通过 Kode::daemon() 构造）。
 * 命令行选项可覆盖 workers / every / cron / daemonize。
 */
function runProcessCommand(array $argv): void
{
    $sub = $argv[2] ?? 'help';

    $pidFile = getenv('KODE_DAEMON_PID_FILE') ?: (sys_get_temp_dir() . '/kode-daemon.pid');
    $cmdFile = getenv('KODE_DAEMON_CMD_FILE') ?: (sys_get_temp_dir() . '/kode-daemon.cmd');

    switch ($sub) {
        case 'start':
            $file = $argv[3] ?? 'daemon.php';
            $opts = parseProcessFlags(array_slice($argv, 4));

            if (!file_exists($file)) {
                echo "Error: Daemon file '{$file}' not found.\n";
                echo "Usage: kode process start <file> [--daemon] [--workers=N] [--every=N] [--cron=expr]\n";
                exit(1);
            }

            if (file_exists($pidFile) && isKodeMaster((int) file_get_contents($pidFile))) {
                echo 'Daemon already running (PID: ' . file_get_contents($pidFile) . ")\n";
                exit(1);
            }

            putenv('KODE_DAEMON_PID_FILE=' . $pidFile);
            file_put_contents($cmdFile, $file);

            echo "Starting daemon from {$file}...\n";
            $daemon = require $file;

            if (!$daemon instanceof \Kode\Process\Daemon\Daemon) {
                echo "Error: daemon file must `return` a Kode\\Process\\Daemon\\Daemon instance.\n";
                @unlink($cmdFile);
                exit(1);
            }

            if (isset($opts['workers'])) {
                $daemon->workers((int) $opts['workers']);
            }
            if (isset($opts['every'])) {
                $daemon->every((float) $opts['every']);
            }
            if (isset($opts['cron'])) {
                $daemon->cron($opts['cron']);
            }
            if (isset($opts['daemon'])) {
                $daemon->daemonize(true);
            }

            $daemon->pidFile($pidFile)->run();
            break;

        case 'stop':
            if (!file_exists($pidFile)) {
                echo "No daemon PID file found. Is it running?\n";
                exit(1);
            }

            $pid = (int) file_get_contents($pidFile);

            if (!isKodeMaster($pid)) {
                echo "Stale PID file (process not a running kode daemon). Cleaning up.\n";
                unlink($pidFile);
                @unlink($cmdFile);
                exit(1);
            }

            posix_kill($pid, Signal::TERM);
            for ($i = 0; $i < 50; $i++) {
                if (!@posix_kill($pid, 0)) {
                    break;
                }
                usleep(100_000);
            }
            if (@posix_kill($pid, 0)) {
                @posix_kill($pid, SIGKILL);
            }
            unlink($pidFile);
            @unlink($cmdFile);
            echo "Daemon stopped (PID: {$pid})\n";
            break;

        case 'restart':
            $file = $argv[3] ?? null;
            restartDaemon($file);
            break;

        case 'status':
            if (!file_exists($pidFile)) {
                echo "Daemon is not running.\n";
                exit(0);
            }

            $pid = (int) file_get_contents($pidFile);

            if (isKodeMaster($pid)) {
                echo "Daemon is running (PID: {$pid})\n";
            } else {
                echo "Daemon is not running (stale PID file).\n";
                unlink($pidFile);
                @unlink($cmdFile);
                exit(1);
            }
            break;

        case 'help':
        default:
            echo <<<'HELP'
Kode Process - 常驻进程运行器 (Daemon)

用法:
    kode process start <file> [options]   启动常驻运行器（<file> 须 return 一个 Daemon 实例）
    kode process stop                     停止运行器
    kode process restart [file]           平滑重启（detached 重启；不传 file 沿用上次文件）
    kode process status                   查看运行状态

选项 (start):
    --daemon          脱离终端常驻
    --workers=N       覆盖 worker 子进程数
    --every=N         覆盖周期间隔（秒）
    --cron=expr       覆盖为 cron 表达式（如 '0 * * * *'）

示例:
    kode process start daemon.php --workers=4 --every=5
    kode process start daemon.php --daemon --cron='0 0 * * *'
    kode process stop
    kode process status

HELP;
            break;
    }
}

/**
 * 解析 process start 的 CLI 选项（--key=value 或 --flag）。
 *
 * @return array<string, mixed>
 */
function parseProcessFlags(array $args): array
{
    $opts = [];

    foreach ($args as $arg) {
        if (!str_starts_with($arg, '--')) {
            continue;
        }

        $kv = substr($arg, 2);

        if (str_contains($kv, '=')) {
            [$k, $v] = explode('=', $kv, 2);
            $opts[$k] = $v;
        } else {
            $opts[$kv] = true;
        }
    }

    return $opts;
}

/**
 * 平滑重启 daemon：停止旧进程，再以 detached 方式启动新进程。
 */
function restartDaemon(?string $file): void
{
    $pidFile = getenv('KODE_DAEMON_PID_FILE') ?: (sys_get_temp_dir() . '/kode-daemon.pid');
    $cmdFile = getenv('KODE_DAEMON_CMD_FILE') ?: (sys_get_temp_dir() . '/kode-daemon.cmd');

    if ($file === null && file_exists($cmdFile)) {
        $file = file_get_contents($cmdFile);
    }
    $file = $file ?: 'daemon.php';

    if (!file_exists($file)) {
        echo "Error: Daemon file '{$file}' not found.\n";
        echo "Usage: kode process restart <file>\n";
        exit(1);
    }

    if (file_exists($pidFile)) {
        $pid = (int) file_get_contents($pidFile);
        if (isKodeMaster($pid)) {
            echo "Stopping old daemon (PID: {$pid})...\n";
            @posix_kill($pid, Signal::TERM);
            for ($i = 0; $i < 50; $i++) {
                if (!@posix_kill($pid, 0)) {
                    break;
                }
                usleep(100_000);
            }
            if (@posix_kill($pid, 0)) {
                @posix_kill($pid, SIGKILL);
                for ($i = 0; $i < 20; $i++) {
                    if (!@posix_kill($pid, 0)) {
                        break;
                    }
                    usleep(100_000);
                }
            }
        }
        if (!@posix_kill($pid, 0)) {
            @unlink($pidFile);
            @unlink($cmdFile);
        }
    }

    $php = escapeshellarg(PHP_BINARY);
    $bin = escapeshellarg(__DIR__ . '/kode');
    $arg = escapeshellarg($file);
    exec("nohup {$php} {$bin} process start {$arg} >/dev/null 2>&1 &");

    $newPid = 0;
    for ($i = 0; $i < 50; $i++) {
        if (file_exists($pidFile)) {
            $candidate = (int) file_get_contents($pidFile);
            if ($candidate > 0 && @posix_kill($candidate, 0)) {
                $newPid = $candidate;
                break;
            }
        }
        usleep(100_000);
    }

    if ($newPid > 0) {
        echo "Daemon restarted (PID: {$newPid}, file: {$file})\n";
    } else {
        echo "Restart launched but new daemon did not become ready. Check logs.\n";
        exit(1);
    }
}

/**
 * 平滑重启：停止旧进程，再以 detached 方式启动新进程。
 */
function restartServer(?string $file): void
{
    // 1. 确定要启动的文件（优先命令行参数，其次沿用上次的启动文件）
    if ($file === null && file_exists(KODE_CMD_FILE)) {
        $file = file_get_contents(KODE_CMD_FILE);
    }
    $file = $file ?: 'server.php';

    if (!file_exists($file)) {
        echo "Error: Server file '{$file}' not found.\n";
        echo "Usage: kode restart <file>\n";
        exit(1);
    }

    // 2. 停止旧进程（若存在且确为 kode master）
    if (file_exists(KODE_PID_FILE)) {
        $pid = (int) file_get_contents(KODE_PID_FILE);
        if (isKodeMaster($pid)) {
            echo "Stopping old server (PID: {$pid})...\n";
            @posix_kill($pid, Signal::TERM);
            // 等待优雅退出（最多约 5 秒）
            for ($i = 0; $i < 50; $i++) {
                if (!@posix_kill($pid, 0)) {
                    break;
                }
                usleep(100_000);
            }
            // 优雅退出超时则强杀，避免遗留孤儿进程继续占用端口
            if (@posix_kill($pid, 0)) {
                @posix_kill($pid, SIGKILL);
                for ($i = 0; $i < 20; $i++) {
                    if (!@posix_kill($pid, 0)) {
                        break;
                    }
                    usleep(100_000);
                }
            }
        }
        // 确认旧进程已死亡后再清理 PID 文件，否则新实例 bind 同端口会失败、
        // 旧进程沦为无 PID 文件可管的孤儿。
        if (!@posix_kill($pid, 0)) {
            @unlink(KODE_PID_FILE);
            @unlink(KODE_CMD_FILE);
        }
    }

    // 3. 以 detached 方式启动新进程（nohup + &，脱离当前进程组独立运行）
    $php = escapeshellarg(PHP_BINARY);
    $bin = escapeshellarg(__DIR__ . '/kode');
    $arg = escapeshellarg($file);
    exec("nohup {$php} {$bin} start {$arg} >/dev/null 2>&1 &");

    // 4. 等待新 PID 文件出现并确认存活
    $newPid = 0;
    for ($i = 0; $i < 50; $i++) {
        if (file_exists(KODE_PID_FILE)) {
            $candidate = (int) file_get_contents(KODE_PID_FILE);
            if ($candidate > 0 && @posix_kill($candidate, 0)) {
                $newPid = $candidate;
                break;
            }
        }
        usleep(100_000);
    }

    if ($newPid > 0) {
        echo "Server restarted (PID: {$newPid}, file: {$file})\n";
    } else {
        echo "Restart launched but new server did not become ready. Check logs.\n";
        exit(1);
    }
}

/**
 * 校验给定 PID 是否为存活的 kode master：先确认进程存活，再尽力核对命令行
 * 含 "kode"（Linux /proc 可用时），避免 PID 复用后误杀无关进程。
 */
function isKodeMaster(int $pid): bool
{
    if ($pid <= 0 || !@posix_kill($pid, 0)) {
        return false;
    }
    if (is_readable("/proc/{$pid}/cmdline")) {
        $cmd = @file_get_contents("/proc/{$pid}/cmdline");
        if ($cmd !== false && !str_contains($cmd, 'kode')) {
            return false;
        }
    }
    return true;
}

/**
 * 运行时依赖自检：列出每个运行时所需的 PHP 扩展 / Composer 包及缺失项。
 */
function printRequirements(): void
{
    $reqs = Runtime::requirements();

    echo "Kode Process 运行时依赖自检\n";
    echo str_repeat('-', 60) . "\n";

    foreach ($reqs as $name => $r) {
        $status = $r['available'] ? 'OK  ' : 'MISS';
        printf(
            "  %-10s [%s]  ext: %s\n",
            $name,
            $status,
            $r['extensions'] === [] ? '-' : implode(', ', $r['extensions'])
        );

        if ($r['missing_extensions'] !== []) {
            echo '      缺失扩展: ' . implode(', ', $r['missing_extensions']) . "\n";
        }
        if ($r['package'] !== null && $r['missing_package']) {
            echo "      缺失包:   {$r['package']}\n";
        }
        if (!$r['available']) {
            echo "      提示:     {$r['hint']}\n";
        }
    }

    echo str_repeat('-', 60) . "\n";
}
