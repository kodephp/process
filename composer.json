{
    "name": "kode/process",
    "description": "PHP 8.3+ 进程编排内核：默认自研 Native 运行时（零扩展、master-worker 多进程），兼容 Swoole/Workerman，内置分布式集群能力（服务发现、分布式锁、Leader 选举、负载均衡、分布式 ID、限流、集群 RPC）",
    "type": "library",
    "keywords": ["php", "process", "runtime", "native", "reactor", "event-loop", "worker", "ipc", "signal", "pool", "swoole", "workerman", "multiprocessing", "queue", "cluster", "distributed", "snowflake", "load-balancer"],
    "license": "Apache-2.0",
    "version": "5.1.5",
    "authors": [
        {
            "name": "KodePHP Team",
            "email": "382601296@qq.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "ext-pcntl": "*",
        "ext-posix": "*",
        "ext-sockets": "*",
        "kode/context": "^3.1",
        "kode/fibers": "^4.5",
        "kode/queue": "^2.2",
        "psr/log": "^2.0|^3.0",
        "workerman/workerman": "^5.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0|^12.0",
        "swoole/ide-helper": "^6.2"
    },
    "suggest": {
        "ext-event": "Reactor / Workerman 首选事件循环驱动（libevent），Linux 上吞吐显著更高",
        "ext-ev": "Reactor / Workerman 备选事件循环驱动（libev）",
        "ext-swoole": "启用 Swoole 运行时适配器（Runtime::make('swoole')），自动择优时优先于 Workerman",
        "ext-sysvshm": "SharedTable 零安装兜底后端（共享内存）",
        "ext-sysvmsg": "System V 消息队列 IPC",
        "ext-sysvsem": "信号量同步",
        "ext-apcu": "SharedTable 零安装兜底后端（优先于 sysvshm）",
        "ext-parallel": "真多线程 Parallel 门面（需 ZTS 构建）",
        "ext-openssl": "SSL/TLS 监听"
    },
    "autoload": {
        "psr-4": {
            "Kode\\Process\\": "src/"
        },
        "files": [
            "src/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Kode\\Process\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "platform-check": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "branch-alias": {
            "dev-main": "5.1.x-dev"
        }
    }
}
